---
layout: base.njk
---
<article class="conteneur gabarit">
	<p class="retour"><a href="/actualites/">Toutes les actualités</a></p>
	<h1 class="titre-page">{{ titre }}</h1>
	<p class="meta"><time datetime="{{ page.date | dateIso }}">{{ page.date | dateFr }}</time></p>
	{% if image | existe %}<div class="image-une">{% image image, "", [800, 1600], "(max-width: 860px) 100vw, 700px" %}</div>{% endif %}
	<div class="prose">{{ content | safe }}</div>
</article>
